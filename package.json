{
  "name": "repo-kb",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-dependency repository coherence checks for staged and diffed Git changes.",
  "type": "module",
  "bin": {
    "repo-kb": "./bin/repo-kb.mjs"
  },
  "scripts": {
    "test": "node --test",
    "coverage": "node --experimental-test-coverage --test",
    "check": "node ./bin/repo-kb.mjs check",
    "check:staged": "node ./bin/repo-kb.mjs scan --staged",
    "status": "node ./bin/repo-kb.mjs status",
    "install:hook": "git config core.hooksPath .githooks"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
